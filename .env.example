# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=comfyui
DB_USER=comfyui
# WARNING: Change this password in production! Generate a strong random password.
DB_PASSWORD=comfyui_password

# API Configuration
NODE_ENV=production
PORT=3000

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
# Volume base path for container mounts (default: /app)
VOLUME_BASE=/app
# ComfyUI Docker image name (default: comfyuiapi-comfyui:latest)
COMFYUI_IMAGE=comfyuiapi-comfyui:latest

# Security Configuration
# CORS origin for production (default: http://localhost:8080)
CORS_ORIGIN=http://localhost:8080

# Frontend Configuration
REACT_APP_API_URL=/api
