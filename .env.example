# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=comfyui
DB_USER=comfyui
# CRITICAL: You MUST change this password in production! Generate a strong random password.
# Example: openssl rand -base64 32
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=60000

# API Configuration
NODE_ENV=production
PORT=3000

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
# Volume base path for container mounts (default: /app)
VOLUME_BASE=/app
# ComfyUI Docker image name (default: comfyuiapi-comfyui:latest)
COMFYUI_IMAGE=comfyuiapi-comfyui:latest

# Security Configuration
# CORS origin for production (default: http://localhost:8080)
CORS_ORIGIN=http://localhost:8080

# Admin authentication token (REQUIRED - generate a secure random token for production)
# Example: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_THIS_TOKEN_IN_PRODUCTION

# Grafana Configuration
# CRITICAL: You MUST change this password in production!
# Example: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Logging Configuration
LOG_LEVEL=info

# Media Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/home/user/comfyuiapi
BASE_URL=http://localhost:3000

# Frontend Configuration
REACT_APP_API_URL=/api
