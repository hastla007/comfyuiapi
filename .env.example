# =============================================================================
# ComfyUI Docker Manager - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and update with your values
# WARNING: Never commit .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database connection settings
DB_HOST=db
DB_PORT=5432
DB_NAME=comfyui
DB_USER=comfyui

# SECURITY WARNING: Change this password in production!
# Generate a strong password: openssl rand -base64 32
DB_PASSWORD=comfyui_password

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Node environment: development, production, or test
NODE_ENV=production

# API server port
PORT=3000

# CORS allowed origin (frontend URL)
# For multiple origins, modify backend/src/index.js
CORS_ORIGIN=http://localhost:8080

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------
# Docker socket path (do not change unless using Docker over TCP)
DOCKER_HOST=unix:///var/run/docker.sock

# Docker network name for ComfyUI containers
# Must match the network name in docker-compose.yml
DOCKER_NETWORK=comfyui-network

# ComfyUI Docker image name
COMFYUI_IMAGE=comfyuiapi-comfyui:latest

# Volume base path for container mounts
# In Docker context, this should be /app
VOLUME_BASE=/app

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for React frontend (relative or absolute)
# Use /api for nginx proxy or http://localhost:3000 for development
REACT_APP_API_URL=/api

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. The Docker socket gives the API full control over Docker on the host
#    This is required for functionality but is a security risk
#    Ensure proper network security and access controls
#
# 2. Always use strong passwords in production
#    Consider using Docker secrets or environment-specific configs
#
# 3. Limit CORS_ORIGIN to your actual frontend domain in production
#
# 4. Keep this file (.env) in .gitignore to prevent credential leaks
# =============================================================================
